+#[cfg(test)]
+mod tests {
+    use super::memory_pipe;
+    use std::io::{Read, Write};
+
+    #[test]
+    fn memory_pipe_applies_backpressure_and_delivers_more_than_its_capacity() {
+        let (mut reader, mut writer) = memory_pipe();
+        let expected = (0..(3 * super::MEMORY_PIPE_CAPACITY + 17))
+            .map(|index| (index % 251) as u8)
+            .collect::<Vec<_>>();
+        let producer_bytes = expected.clone();
+        let producer = std::thread::spawn(move || {
+            writer.write_all(&producer_bytes).unwrap();
+        });
+        let mut actual = Vec::new();
+        reader.read_to_end(&mut actual).unwrap();
+        producer.join().unwrap();
+        assert_eq!(actual, expected);
+    }
+
+    #[test]
+    fn memory_pipe_reports_broken_pipe_after_the_last_reader_closes() {
+        let (reader, mut writer) = memory_pipe();
+        let reader_clone = reader.clone();
+        drop(reader);
+        writer.write_all(b"still connected").unwrap();
+        drop(reader_clone);
+        let error = writer.write_all(b"closed").unwrap_err();
+        assert_eq!(error.kind(), std::io::ErrorKind::BrokenPipe);
+    }
+}
