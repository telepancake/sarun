+#[cfg(test)]
+mod userspace_pipe_tests {
+    use super::command_is_userspace_pipe_safe;
+    use crate::{builtins, extensions, results};
+    use brush_parser::ast;
+
+    struct LeafBuiltin;
+
+    impl builtins::SimpleCommand for LeafBuiltin {
+        fn get_content(
+            _name: &str,
+            _content_type: builtins::ContentType,
+            _options: &builtins::ContentOptions,
+        ) -> Result<String, crate::error::Error> {
+            Ok(String::new())
+        }
+
+        fn execute<SE, I, S>(
+            _context: crate::commands::ExecutionContext<'_, SE>,
+            _args: I,
+        ) -> Result<results::ExecutionResult, crate::error::Error>
+        where
+            SE: extensions::ShellExtensions,
+            I: Iterator<Item = S>,
+            S: AsRef<str>,
+        {
+            Ok(results::ExecutionResult::success())
+        }
+    }
+
+    fn simple(name: &str, args: &[&str]) -> ast::Command {
+        ast::Command::Simple(ast::SimpleCommand {
+            prefix: None,
+            word_or_name: Some(name.to_string().into()),
+            suffix: (!args.is_empty()).then(|| {
+                ast::CommandSuffix(
+                    args.iter()
+                        .map(|arg| {
+                            ast::CommandPrefixOrSuffixItem::Word((*arg).to_string().into())
+                        })
+                        .collect(),
+                )
+            }),
+        })
+    }
+
+    #[tokio::test]
+    async fn only_explicit_unshadowed_leaf_builtins_are_userspace_pipe_safe() {
+        let safe = builtins::simple_builtin::<LeafBuiltin, extensions::DefaultShellExtensions>()
+            .userspace_pipe_safe();
+        let unsafe_registration =
+            builtins::simple_builtin::<LeafBuiltin, extensions::DefaultShellExtensions>();
+        let mut registrations = std::collections::HashMap::new();
+        registrations.insert("safe".to_string(), safe);
+        registrations.insert("dispatcher".to_string(), unsafe_registration);
+        let mut shell = crate::Shell::builder()
+            .builtins(registrations)
+            .build()
+            .await
+            .unwrap();
+
+        assert!(command_is_userspace_pipe_safe(
+            &simple("safe", &["literal", "$ordinary_parameter"]),
+            &shell,
+        ));
+        assert!(!command_is_userspace_pipe_safe(
+            &simple("dispatcher", &[]),
+            &shell,
+        ));
+        assert!(!command_is_userspace_pipe_safe(
+            &simple("$dynamic_name", &[]),
+            &shell,
+        ));
+        assert!(!command_is_userspace_pipe_safe(
+            &simple("safe", &["$(external-command)"]),
+            &shell,
+        ));
+
+        shell.aliases_mut().insert("safe".into(), "dispatcher".into());
+        assert!(!command_is_userspace_pipe_safe(
+            &simple("safe", &[]),
+            &shell,
+        ));
+    }
+}
