+const MEMORY_PIPE_CAPACITY: usize = 64 * 1024;
+
+struct MemoryPipeState {
+    bytes: VecDeque<u8>,
+    reader_open: bool,
+    writer_open: bool,
+}
+
+struct MemoryPipeShared {
+    state: Mutex<MemoryPipeState>,
+    readable: Condvar,
+    writable: Condvar,
+}
+
+/// Read endpoint of a bounded userspace pipe. There is one endpoint object per
+/// pipe; cloned [`OpenFile`] values share it through `Arc`, just as they share
+/// kernel pipe descriptors.
+#[doc(hidden)]
+pub struct MemoryPipeReader {
+    shared: Arc<MemoryPipeShared>,
+}
+
+/// Write endpoint paired with [`MemoryPipeReader`].
+#[doc(hidden)]
+pub struct MemoryPipeWriter {
+    shared: Arc<MemoryPipeShared>,
+}
+
+impl std::io::Read for &MemoryPipeReader {
+    fn read(&mut self, output: &mut [u8]) -> std::io::Result<usize> {
+        if output.is_empty() {
+            return Ok(0);
+        }
+        let mut state = self
+            .shared
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        while state.bytes.is_empty() && state.writer_open {
+            state = self
+                .shared
+                .readable
+                .wait(state)
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+        }
+        let count = output.len().min(state.bytes.len());
+        let (front, back) = state.bytes.as_slices();
+        let front_count = count.min(front.len());
+        output[..front_count].copy_from_slice(&front[..front_count]);
+        let back_count = count - front_count;
+        output[front_count..count].copy_from_slice(&back[..back_count]);
+        state.bytes.drain(..count);
+        if count != 0 {
+            self.shared.writable.notify_one();
+        }
+        Ok(count)
+    }
+}
+
+impl std::io::Write for &MemoryPipeWriter {
+    fn write(&mut self, input: &[u8]) -> std::io::Result<usize> {
+        if input.is_empty() {
+            return Ok(0);
+        }
+        let mut state = self
+            .shared
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        while state.bytes.len() == MEMORY_PIPE_CAPACITY && state.reader_open {
+            state = self
+                .shared
+                .writable
+                .wait(state)
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+        }
+        if !state.reader_open {
+            return Err(std::io::Error::from(std::io::ErrorKind::BrokenPipe));
+        }
+        let count = input
+            .len()
+            .min(MEMORY_PIPE_CAPACITY.saturating_sub(state.bytes.len()));
+        state.bytes.extend(&input[..count]);
+        self.shared.readable.notify_one();
+        Ok(count)
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+impl Drop for MemoryPipeReader {
+    fn drop(&mut self) {
+        let mut state = self
+            .shared
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        state.reader_open = false;
+        state.bytes.clear();
+        self.shared.writable.notify_all();
+    }
+}
+
+impl Drop for MemoryPipeWriter {
+    fn drop(&mut self) {
+        let mut state = self
+            .shared
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        state.writer_open = false;
+        self.shared.readable.notify_all();
+    }
+}
+
+/// Construct a bounded pipe whose payload never enters the kernel. This is
+/// deliberately crate-private: callers must prove that neither endpoint can
+/// be handed to an external process or otherwise require a native descriptor.
+pub(crate) fn memory_pipe() -> (OpenFile, OpenFile) {
+    let shared = Arc::new(MemoryPipeShared {
+        state: Mutex::new(MemoryPipeState {
+            bytes: VecDeque::new(),
+            reader_open: true,
+            writer_open: true,
+        }),
+        readable: Condvar::new(),
+        writable: Condvar::new(),
+    });
+    (
+        OpenFile::MemoryPipeReader(Arc::new(MemoryPipeReader {
+            shared: Arc::clone(&shared),
+        })),
+        OpenFile::MemoryPipeWriter(Arc::new(MemoryPipeWriter { shared })),
+    )
+}
