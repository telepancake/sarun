+/// Prove the narrow condition needed by [`openfiles::memory_pipe`]. Raw command
+/// names must identify an explicitly opted-in leaf builtin, with no function or
+/// alias shadow and no prefix/redirection/process substitution. Arguments may
+/// still contain ordinary parameter expansion, but command substitutions are
+/// excluded because they can run an external command against inherited fds.
+fn command_is_userspace_pipe_safe(
+    command: &ast::Command,
+    shell: &Shell<impl extensions::ShellExtensions>,
+) -> bool {
+    let ast::Command::Simple(simple) = command else {
+        return false;
+    };
+    if simple.prefix.is_some() {
+        return false;
+    }
+    let Some(name) = simple.word_or_name.as_ref().map(|word| word.value.as_str()) else {
+        return false;
+    };
+    if shell.aliases().contains_key(name) || shell.funcs().get(name).is_some() {
+        return false;
+    }
+    let Some(registration) = shell.builtins().get(name) else {
+        return false;
+    };
+    if registration.disabled || !registration.userspace_pipe_safe {
+        return false;
+    }
+    simple.suffix.as_ref().is_none_or(|suffix| {
+        suffix.0.iter().all(|item| match item {
+            ast::CommandPrefixOrSuffixItem::Word(word) => {
+                !word.value.contains("$(") && !word.value.contains('`')
+            }
+            ast::CommandPrefixOrSuffixItem::IoRedirect(_)
+            | ast::CommandPrefixOrSuffixItem::AssignmentWord(_, _)
+            | ast::CommandPrefixOrSuffixItem::ProcessSubstitution(_, _) => false,
+        })
+    })
+}
