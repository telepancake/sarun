+/// thread. Prefer [`push_utility_name`] for a single invocation.
+pub fn set_utility_name(name: &'static str) {
     UTIL_NAME_OVERRIDE.with(|c| {
         if name.is_empty() {
             c.set(None);
         } else {
-            c.set(Some(Box::leak(name.to_string().into_boxed_str())));
+            c.set(Some(name));
         }
     });
 }
 
+/// Bind a statically-known embedded utility name for one command invocation.
+/// Unlike the old adapter this neither allocates nor leaks a new string per
+/// call, and nested invocations restore their caller's name.
+pub fn push_utility_name(name: &'static str) -> UtilityNameGuard {
+    let previous = UTIL_NAME_OVERRIDE.with(|slot| slot.replace(Some(name)));
+    UtilityNameGuard {
+        previous,
+        _thread_bound: std::marker::PhantomData,
+    }
+}
