From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bumba <noreply@bumba>
Date: Mon, 24 Aug 2026 17:59:49 +0000
Subject: [PATCH] brush coreutils: return scoped uutil runtime guards

Bind the canonical utility name and keyed localization for one invocation, restoring the caller on drop. This makes inline multi-utility embedding safe and removes the need for disposable localization threads.

---
diff --git a/src/lib.rs b/src/lib.rs
index dff1d9a..f9cc36a 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -50,20 +50,20 @@ use std::ffi::OsString;
 /// Matches `uucore::bin!` behavior on localization-init failure: exit 99.
 /// (This is uutils' contract, not brush's — the fact that brush-core uses 99
 /// for `ExecutionExitCode::Unimplemented` is coincidental.)
-/// `setup_localization` is idempotent per thread, so repeated invocations
-/// (e.g., successive bundled-dispatch calls in a long-lived host, if that
-/// ever happens) are cheap.
-#[allow(
-    dead_code,
-    reason = "only called by adapters generated by the `register!` macro; with no coreutils.* features enabled, no adapter exists"
-)]
-fn prepare_uutil_runtime(util_crate_name: &str) {
+/// Parsed bundles are cached by utility and locale on the calling thread;
+/// repeated invocations only switch a scoped binding.
+pub struct UutilRuntimeGuard {
+    _utility_name: uucore::UtilityNameGuard,
+    _localization: uucore::locale::LocalizationGuard,
+}
+
+fn prepare_uutil_runtime(util_crate_name: &'static str) -> UutilRuntimeGuard {
     // ORDERING CONTRACT (sarun): the caller must have already installed the
     // shell's logical environment for this thread
-    // (`uucore::logical_env::set_logical_env`) BEFORE calling this. Localization
+    // (`uucore::logical_env::push`) BEFORE calling this. Localization
     // setup below reads `LANG`/`LC_*` through `uucore::logical_env::get`, so the
     // shell's exported locale knobs only reach the Fluent bundle if the override
-    // is in place first. The engine's `run_coreutil_localized` guarantees this;
+    // is in place first. The engine's `run_coreutil_scoped` guarantees this;
     // the `register!` adapter path (standalone bundled dispatch) installs no
     // override, so `get` falls through to the process env as upstream expects.
     uucore::panic::preserve_inherited_sigpipe();
@@ -73,13 +73,17 @@ fn prepare_uutil_runtime(util_crate_name: &str) {
     // diagnostics through `uucore::util_name()` (e.g. wc, sort, tr) show their
     // own name rather than the host process's argv[0] ("sarun"). uucore derives
     // util_name() process-globally from argv[0] — correct for the
-    // one-util-per-process model but wrong for an embedder running each util on
-    // its own thread. `localization_name` is already the canonical util name
+    // one-util-per-process model but wrong for a multi-utility embedder.
+    // `localization_name` is already the canonical util name
     // (uu_wc -> "wc", alias map applied), exactly what we want here.
-    uucore::set_utility_name(localization_name);
-    if let Err(err) = uucore::locale::setup_localization(localization_name) {
+    let utility_name = uucore::push_utility_name(localization_name);
+    let localization = uucore::locale::push_localization(localization_name).unwrap_or_else(|err| {
         eprintln!("brush: could not initialize localization for '{localization_name}': {err}");
         std::process::exit(99);
+    });
+    UutilRuntimeGuard {
+        _utility_name: utility_name,
+        _localization: localization,
     }
 }
 
@@ -88,9 +92,10 @@ fn prepare_uutil_runtime(util_crate_name: &str) {
 /// LOGICAL entry point directly — bypassing the `register!` adapter, as the
 /// engine's native injected-I/O `cat` builtin does — still renders `translate!`
 /// messages instead of raw Fluent keys. Mirrors the setup half the generated
-/// adapter runs (sans the stdin/stdout dance), and is idempotent per thread.
-pub fn init_localization(util_crate_name: &str) {
-    prepare_uutil_runtime(util_crate_name);
+/// adapter runs (sans the stdin/stdout dance). The returned guard restores the
+/// caller's utility and localization bindings on drop.
+pub fn init_localization(util_crate_name: &'static str) -> UutilRuntimeGuard {
+    prepare_uutil_runtime(util_crate_name)
 }
 
 /// Second half of the `uucore::bin!` body: flush stdout after `uumain`
@@ -119,7 +124,7 @@ macro_rules! register {
         #[cfg(feature = $feature)]
         {
             fn adapter(args: Vec<OsString>) -> i32 {
-                $crate::prepare_uutil_runtime(stringify!($util_crate));
+                let _runtime = $crate::prepare_uutil_runtime(stringify!($util_crate));
                 let code = $util_crate::uumain(args.into_iter());
                 $crate::finalize_uutil_runtime();
                 code
