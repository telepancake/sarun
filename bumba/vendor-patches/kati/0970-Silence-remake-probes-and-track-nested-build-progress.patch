@@ -533,3 +595,46 @@ pub fn report_var_assign(
         h(name, loc, value, make_dir, rhs, op, origin);
     }
 }
+
+#[cfg(test)]
+mod activity_tests {
+    use super::*;
+
+    #[test]
+    fn nested_workers_share_progress_but_unrelated_invocations_do_not() {
+        let _parent = ActivityGuard::new("parent recipe".into());
+        let parent_progress = current_activity_progress().unwrap();
+        {
+            let _nested = ActivityGuard::new_with_progress(
+                "nested worker".into(),
+                Some(parent_progress.clone()),
+            );
+            let nested_progress = current_activity_progress().unwrap();
+            assert!(Arc::ptr_eq(&parent_progress.0, &nested_progress.0));
+        }
+
+        let unrelated_progress = std::thread::spawn(|| {
+            let _unrelated = ActivityGuard::new("unrelated make".into());
+            current_activity_progress().unwrap()
+        })
+        .join()
+        .unwrap();
+        assert!(!Arc::ptr_eq(&parent_progress.0, &unrelated_progress.0));
+    }
+
+    #[test]
+    fn long_activity_is_not_stalled_while_other_work_completes() {
+        let now = std::time::Instant::now();
+        let started = now - std::time::Duration::from_secs(900);
+        let recent_progress = now - std::time::Duration::from_secs(1);
+        assert!(!activity_is_stalled(now, started, recent_progress, 300));
+    }
+
+    #[test]
+    fn long_activity_is_stalled_after_its_progress_lineage_stops() {
+        let now = std::time::Instant::now();
+        let started = now - std::time::Duration::from_secs(900);
+        let last_progress = now - std::time::Duration::from_secs(301);
+        assert!(activity_is_stalled(now, started, last_progress, 300));
+    }
+}
