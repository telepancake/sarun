+struct RunWork {
+    req: RunReq,
+    slip: Option<u8>,
+}
+
+struct WorkQueueState {
+    queue: std::collections::VecDeque<RunWork>,
+    closed: bool,
+}
+
+/// A make invocation owns at most `cap` persistent recipe workers. The old
+/// scheduler created and destroyed a 64 MiB-stack thread for every target;
+/// large generated builds can contain hundreds of thousands of short recipes,
+/// making thread lifecycle more expensive than the work itself.
+struct RecipeWorkers {
+    queue: Arc<(Mutex<WorkQueueState>, parking_lot::Condvar)>,
+    workers: Vec<std::thread::JoinHandle<()>>,
+}
+
+impl RecipeWorkers {
+    fn new(
+        cap: usize,
+        shell: Bytes,
+        shellflag: &'static [u8],
+        recipe_stdin: Option<Arc<std::os::fd::OwnedFd>>,
+        tx: std::sync::mpsc::Sender<RunMsg>,
+        filesystem: Option<Arc<dyn crate::filesystem::FileSystemProvider>>,
+    ) -> Self {
+        let queue = Arc::new((
+            Mutex::new(WorkQueueState {
+                queue: std::collections::VecDeque::new(),
+                closed: false,
+            }),
+            parking_lot::Condvar::new(),
+        ));
+        let mut workers = Vec::with_capacity(cap);
+        for worker_index in 0..cap {
+            let queue = Arc::clone(&queue);
+            let shell = shell.clone();
+            let recipe_stdin = recipe_stdin.clone();
+            let tx = tx.clone();
+            let filesystem = filesystem.clone();
+            workers.push(
+                std::thread::Builder::new()
+                    .name(format!("kati-recipe-{worker_index}"))
+                    // A worker can execute a recursive make whose parser uses a
+                    // deep Rust call stack (notably Linux Kbuild).
+                    .stack_size(64 * 1024 * 1024)
+                    .spawn(move || loop {
+                        let work = {
+                            let (lock, ready) = &*queue;
+                            let mut state = lock.lock();
+                            while state.queue.is_empty() && !state.closed {
+                                ready.wait(&mut state);
+                            }
+                            match state.queue.pop_front() {
+                                Some(work) => work,
+                                None => break,
+                            }
+                        };
+                        let _filesystem = filesystem
+                            .clone()
+                            .map(crate::filesystem::install_file_system_provider);
+                        let mut emit = |bytes: &[u8]| {
+                            let _ = tx.send(RunMsg::Chunk(bytes.to_vec()));
+                        };
+                        let _activity = crate::fileutil::ActivityGuard::new(format!(
+                            "recipe of '{}'",
+                            work.req.output
+                        ));
+                        let result = run_node_commands(
+                            &shell,
+                            shellflag,
+                            recipe_stdin.clone(),
+                            work.req,
+                            &mut emit,
+                        );
+                        let _ = tx.send(RunMsg::Done(result, work.slip));
+                    })
+                    .expect("spawn kati recipe worker"),
+            );
+        }
+        Self { queue, workers }
+    }
+
+    fn submit(&self, work: RunWork) {
+        let (lock, ready) = &*self.queue;
+        lock.lock().queue.push_back(work);
+        ready.notify_one();
+    }
+}
+
+impl Drop for RecipeWorkers {
+    fn drop(&mut self) {
+        let (lock, ready) = &*self.queue;
+        {
+            let mut state = lock.lock();
+            state.closed = true;
+            state.queue.clear();
+        }
+        ready.notify_all();
+        for worker in self.workers.drain(..) {
+            let _ = worker.join();
+        }
+    }
+}
