 //! We open our OWN non-blocking handle to the fifo path so try_acquire never
 //! stalls the scheduler; forked tools open their own (blocking) handles.
 
-/// A non-blocking handle on the engine slip pool (the FUSE fifo).
+/// A connection to either a FIFO jobserver or inherited descriptor pair.
 pub struct Client {
-    fd: i32,
+    read_fd: i32,
+    write_fd: i32,
+    owned: bool,
+}
+
+fn flag_value<'a>(makeflags: &'a str, name: &str) -> Option<&'a str> {
+    makeflags
+        .split_whitespace()
+        .find_map(|token| token.strip_prefix(name))
 }
 
 fn fifo_path(makeflags: &str) -> Option<&str> {
-    makeflags.split_whitespace().find_map(|tok| {
-        tok.strip_prefix("--jobserver-auth=")
-            .or_else(|| tok.strip_prefix("--jobserver-fds="))
-            .and_then(|v| v.strip_prefix("fifo:"))
-    })
+    flag_value(makeflags, "--jobserver-auth=")
+        .or_else(|| flag_value(makeflags, "--jobserver-fds="))
+        .and_then(|value| value.strip_prefix("fifo:"))
+}
+
+fn fd_pair(makeflags: &str) -> Option<(i32, i32)> {
+    let value = flag_value(makeflags, "--jobserver-auth=")
+        .or_else(|| flag_value(makeflags, "--jobserver-fds="))?;
+    let (read, write) = value.split_once(',')?;
+    Some((read.parse().ok()?, write.parse().ok()?))
 }
 
 impl Client {
+    /// Connect to the jobserver described by this make invocation's logical
+    /// `MAKEFLAGS`. Embedded makes must not consult the host process environment:
+    /// several invocations with different environments may coexist there.
+    pub fn from_makeflags(makeflags: &[u8]) -> Option<Client> {
+        let mf = std::str::from_utf8(makeflags).ok()?;
+        if let Some(path) = fifo_path(mf) {
+            let c = std::ffi::CString::new(path).ok()?;
+            let fd = unsafe { libc::open(c.as_ptr(), libc::O_RDWR | libc::O_NONBLOCK) };
+            if fd < 0 {
+                return None;
+            }
+            return Some(Client {
+                read_fd: fd,
+                write_fd: fd,
+                owned: true,
+            });
+        }
+        let (read_fd, write_fd) = fd_pair(mf)?;
+        if unsafe { libc::fcntl(read_fd, libc::F_GETFD) } < 0
+            || unsafe { libc::fcntl(write_fd, libc::F_GETFD) } < 0
+        {
+            return None;
+        }
+        Some(Client {
+            read_fd,
+            write_fd,
+            owned: false,
+        })
+    }
+
     /// Connect to the fifo jobserver named in MAKEFLAGS, if any.
     pub fn from_env() -> Option<Client> {
         let mf = std::env::var("MAKEFLAGS").ok()?;
-        let path = fifo_path(&mf)?;
-        let c = std::ffi::CString::new(path).ok()?;
-        let fd = unsafe { libc::open(c.as_ptr(), libc::O_RDWR | libc::O_NONBLOCK) };
-        if fd < 0 {
-            return None;
-        }
-        Some(Client { fd })
+        Self::from_makeflags(mf.as_bytes())
     }
 
     /// Claim a slip without blocking. None ⇒ pool momentarily empty.
     pub fn try_acquire(&self) -> Option<u8> {
         let mut b = [0u8; 1];
-        let n = unsafe { libc::read(self.fd, b.as_mut_ptr() as *mut libc::c_void, 1) };
+        if !self.owned {
+            let mut pollfd = libc::pollfd {
+                fd: self.read_fd,
+                events: libc::POLLIN,
+                revents: 0,
+            };
+            let ready = unsafe { libc::poll(&mut pollfd, 1, 0) };
+            if ready <= 0 || (pollfd.revents & libc::POLLIN) == 0 {
+                return None;
+            }
+        }
+        let n = unsafe { libc::read(self.read_fd, b.as_mut_ptr().cast::<libc::c_void>(), 1) };
         if n == 1 { Some(b[0]) } else { None }
     }
 
     /// Return a slip to the pool.
     pub fn release(&self, token: u8) {
         let b = [token];
-        unsafe { libc::write(self.fd, b.as_ptr() as *const libc::c_void, 1) };
+        unsafe { libc::write(self.write_fd, b.as_ptr().cast::<libc::c_void>(), 1) };
     }
 }
 
 impl Drop for Client {
     fn drop(&mut self) {
-        unsafe { libc::close(self.fd) };
+        if self.owned {
+            unsafe { libc::close(self.read_fd) };
+        }
     }
