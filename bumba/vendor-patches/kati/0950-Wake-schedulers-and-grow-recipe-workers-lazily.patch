+impl RunSender {
+    fn send(&self, message: RunMsg) {
+        use std::os::fd::AsRawFd;
+
+        if self.tx.send(message).is_ok() {
+            let byte = [1u8];
+            // The pipe is nonblocking. A full pipe is already readable, so a
+            // failed notification cannot hide queued channel messages.
+            unsafe {
+                libc::write(
+                    self.notify.as_raw_fd(),
+                    byte.as_ptr().cast::<libc::c_void>(),
+                    byte.len(),
+                );
+            }
+        }
+    }
+}
