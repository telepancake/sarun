+fn set_nonblocking(fd: i32) -> std::io::Result<()> {
+    let flags = unsafe { libc::fcntl(fd, libc::F_GETFL) };
+    if flags < 0 || unsafe { libc::fcntl(fd, libc::F_SETFL, flags | libc::O_NONBLOCK) } < 0 {
+        Err(std::io::Error::last_os_error())
+    } else {
+        Ok(())
+    }
+}
+
+/// Wait for either a worker message or a newly available jobserver token.
+/// Returning `None` means token readiness: the caller retries dispatch before
+/// blocking again. Channel state is checked before and after polling so a full
+/// notification pipe cannot lose a wakeup.
+fn wait_for_run_message(
+    rx: &std::sync::mpsc::Receiver<RunMsg>,
+    notify: &std::io::PipeReader,
+    jobserver_fd: Option<i32>,
+) -> Option<RunMsg> {
+    use std::os::fd::AsRawFd;
+
+    loop {
+        match rx.try_recv() {
+            Ok(message) => return Some(message),
+            Err(std::sync::mpsc::TryRecvError::Disconnected) => return None,
+            Err(std::sync::mpsc::TryRecvError::Empty) => {}
+        }
+        let mut fds = [
+            libc::pollfd {
+                fd: notify.as_raw_fd(),
+                events: libc::POLLIN,
+                revents: 0,
+            },
+            libc::pollfd {
+                fd: jobserver_fd.unwrap_or(-1),
+                events: libc::POLLIN,
+                revents: 0,
+            },
+        ];
+        let count = if jobserver_fd.is_some() { 2 } else { 1 };
+        let ready = unsafe { libc::poll(fds.as_mut_ptr(), count, -1) };
+        if ready < 0 {
+            if std::io::Error::last_os_error().kind() == std::io::ErrorKind::Interrupted {
+                continue;
+            }
+            return None;
+        }
+        if (fds[0].revents & libc::POLLIN) != 0 {
+            let mut bytes = [0u8; 256];
+            loop {
+                let read = unsafe {
+                    libc::read(
+                        notify.as_raw_fd(),
+                        bytes.as_mut_ptr().cast::<libc::c_void>(),
+                        bytes.len(),
+                    )
+                };
+                if read <= 0 || read < bytes.len() as isize {
+                    break;
+                }
+            }
+            match rx.try_recv() {
+                Ok(message) => return Some(message),
+                Err(std::sync::mpsc::TryRecvError::Disconnected) => return None,
+                Err(std::sync::mpsc::TryRecvError::Empty) => continue,
+            }
+        }
+        if (fds[1].revents & libc::POLLIN) != 0 {
+            return None;
+        }
+    }
+}
