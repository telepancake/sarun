+#[cfg(test)]
+mod scheduler_tests {
+    use super::*;
+    use std::os::fd::AsRawFd;
+
+    #[test]
+    fn returned_jobserver_token_wakes_waiting_scheduler() {
+        let (_tx, rx) = std::sync::mpsc::channel();
+        let (notify_reader, notify_writer) = std::io::pipe().unwrap();
+        set_nonblocking(notify_reader.as_raw_fd()).unwrap();
+        set_nonblocking(notify_writer.as_raw_fd()).unwrap();
+        let (token_reader, token_writer) = std::io::pipe().unwrap();
+        let writer = std::thread::spawn(move || {
+            std::thread::sleep(std::time::Duration::from_millis(20));
+            let token = [b'+'];
+            assert_eq!(unsafe {
+                libc::write(
+                    token_writer.as_raw_fd(),
+                    token.as_ptr().cast::<libc::c_void>(),
+                    token.len(),
+                )
+            }, 1);
+        });
+        let started = std::time::Instant::now();
+        assert!(wait_for_run_message(
+            &rx, &notify_reader, Some(token_reader.as_raw_fd())).is_none());
+        assert!(started.elapsed() < std::time::Duration::from_secs(1));
+        writer.join().unwrap();
+    }
+
+    #[test]
+    fn recipe_pool_grows_only_to_dispatched_concurrency() {
+        let pool = RecipePool::new();
+        assert_eq!(pool.workers.lock().len(), 0);
+        pool.ensure_workers(1);
+        assert_eq!(pool.workers.lock().len(), 1);
+        pool.ensure_workers(1);
+        assert_eq!(pool.workers.lock().len(), 1);
+        pool.ensure_workers(3);
+        assert_eq!(pool.workers.lock().len(), 3);
+    }
+}
