+++ b/src/task.rs
@@ -1,12 +1,10 @@
 //! Runs build tasks, potentially in parallel.
 //! Unaware of the build graph, pools, etc.; just command execution.
 //!
-//! We use one thread per subprocess.  This differs from Ninja which goes to
-//! some effort to use ppoll-like behavior.  Because the threads are mostly
-//! blocked in IO I don't expect this to be too costly in terms of CPU, but it's
-//! worth considering how much RAM it costs.  On the positive side, the logic
-//! is significantly simpler than Ninja and we get free behaviors like parallel
-//! parsing of depfiles.
+//! A fixed worker pool runs subprocesses and parses their depfiles. The main
+//! scheduler polls both worker notifications and the GNU make jobserver, so a
+//! returned token can dispatch queued work without waiting for an unrelated
+//! process to finish.
 
 use crate::{
     depfile,
@@ -16,7 +14,8 @@ use crate::{
 };
 use anyhow::{anyhow, bail};
 use std::path::{Path, PathBuf};
-use std::sync::mpsc;
+use std::collections::VecDeque;
+use std::sync::{Arc, Condvar, Mutex, mpsc};
 use std::time::Instant;
 
 pub struct FinishedTask {
@@ -188,23 +187,95 @@ enum Message {
     Done(FinishedTask),
 }
 
+#[derive(Clone)]
+struct TaskSender {
+    tx: mpsc::Sender<Message>,
+    notify: Arc<std::io::PipeWriter>,
+}
+
+impl TaskSender {
+    fn send(&self, message: Message) {
+        use std::os::fd::AsRawFd;
+        if self.tx.send(message).is_ok() {
+            let byte = [1u8];
+            unsafe {
+                libc::write(
+                    self.notify.as_raw_fd(),
+                    byte.as_ptr().cast::<libc::c_void>(),
+                    byte.len(),
+                );
+            }
+        }
+    }
+}
+
+type RunnerTask = Box<dyn FnOnce() + Send + 'static>;
+
+struct TaskQueue {
+    tasks: VecDeque<RunnerTask>,
+    closed: bool,
+}
+
 pub struct Runner {
     tx: mpsc::Sender<Message>,
     rx: mpsc::Receiver<Message>,
     pub running: usize,
     tids: ThreadIds,
     parallelism: usize,
+    queue: Arc<(Mutex<TaskQueue>, Condvar)>,
+    workers: Vec<std::thread::JoinHandle<()>>,
+    notify: std::io::PipeReader,
+    notify_writer: Arc<std::io::PipeWriter>,
 }
 
 impl Runner {
     pub fn new(parallelism: usize) -> Self {
         let (tx, rx) = mpsc::channel();
+        let (notify, notify_writer) = std::io::pipe().expect("create n2 notification pipe");
+        fn nonblocking(fd: i32) {
+            let flags = unsafe { libc::fcntl(fd, libc::F_GETFL) };
+            assert!(flags >= 0);
+            assert!(unsafe { libc::fcntl(fd, libc::F_SETFL, flags | libc::O_NONBLOCK) } >= 0);
+        }
+        use std::os::fd::AsRawFd;
+        nonblocking(notify.as_raw_fd());
+        nonblocking(notify_writer.as_raw_fd());
+        let notify_writer = Arc::new(notify_writer);
+        let queue = Arc::new((
+            Mutex::new(TaskQueue { tasks: VecDeque::new(), closed: false }),
+            Condvar::new(),
+        ));
+        let mut workers = Vec::with_capacity(parallelism);
+        for index in 0..parallelism {
+            let queue = Arc::clone(&queue);
+            workers.push(std::thread::Builder::new()
+                .name(format!("n2-recipe-{index}"))
+                .spawn(move || loop {
+                    let task = {
+                        let (lock, ready) = &*queue;
+                        let mut state = lock.lock().unwrap();
+                        while state.tasks.is_empty() && !state.closed {
+                            state = ready.wait(state).unwrap();
+                        }
+                        match state.tasks.pop_front() {
+                            Some(task) => task,
+                            None => break,
+                        }
+                    };
+                    task();
+                })
+                .expect("spawn n2 recipe worker"));
+        }
         Runner {
             tx,
             rx,
             running: 0,
             tids: ThreadIds::default(),
             parallelism,
+            queue,
+            workers,
+            notify,
+            notify_writer,
         }
     }
 
