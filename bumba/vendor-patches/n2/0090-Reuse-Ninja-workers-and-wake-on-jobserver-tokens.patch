     }
+
+    #[test]
+    fn returned_jobserver_token_wakes_runner() {
+        use std::io::Write;
+        use std::os::fd::AsRawFd;
+
+        let mut runner = Runner::new(1);
+        let (reader, mut writer) = std::io::pipe().unwrap();
+        writer.write_all(b"+").unwrap();
+
+        let task = runner.wait(Some(reader.as_raw_fd()), |_, _| {});
+        assert!(task.is_none());
+    }
 }
