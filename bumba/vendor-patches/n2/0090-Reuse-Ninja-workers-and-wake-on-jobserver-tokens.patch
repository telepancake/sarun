         self.running += 1;
     }
 
-    /// Wait for a build to complete.  May block for a long time.
-    pub fn wait(&mut self, mut output: impl FnMut(BuildId, Vec<u8>)) -> FinishedTask {
+    /// Wait for either task progress or a returned jobserver token. `None`
+    /// means the jobserver fd became readable and dispatch should be retried.
+    pub fn wait(
+        &mut self,
+        jobserver_fd: Option<i32>,
+        mut output: impl FnMut(BuildId, Vec<u8>),
+    ) -> Option<FinishedTask> {
+        use std::os::fd::AsRawFd;
+
         loop {
-            match self.rx.recv().unwrap() {
+            let message = match self.rx.try_recv() {
+                Ok(message) => Some(message),
+                Err(mpsc::TryRecvError::Disconnected) => return None,
+                Err(mpsc::TryRecvError::Empty) => None,
+            };
+            let message = if let Some(message) = message {
+                message
+            } else {
+                let mut fds = [
+                    libc::pollfd {
+                        fd: self.notify.as_raw_fd(),
+                        events: libc::POLLIN,
+                        revents: 0,
+                    },
+                    libc::pollfd {
+                        fd: jobserver_fd.unwrap_or(-1),
+                        events: libc::POLLIN,
+                        revents: 0,
+                    },
+                ];
+                let count = if jobserver_fd.is_some() { 2 } else { 1 };
+                let ready = unsafe { libc::poll(fds.as_mut_ptr(), count, -1) };
+                if ready < 0 {
+                    if std::io::Error::last_os_error().kind()
+                        == std::io::ErrorKind::Interrupted
+                    {
+                        continue;
+                    }
+                    return None;
+                }
+                if (fds[0].revents & libc::POLLIN) != 0 {
+                    let mut bytes = [0u8; 256];
+                    loop {
+                        let read = unsafe {
+                            libc::read(
+                                self.notify.as_raw_fd(),
+                                bytes.as_mut_ptr().cast::<libc::c_void>(),
+                                bytes.len(),
+                            )
+                        };
+                        if read <= 0 || read < bytes.len() as isize {
+                            break;
+                        }
+                    }
+                    match self.rx.try_recv() {
+                        Ok(message) => message,
+                        Err(mpsc::TryRecvError::Empty) => continue,
+                        Err(mpsc::TryRecvError::Disconnected) => return None,
+                    }
+                } else if (fds[1].revents & libc::POLLIN) != 0 {
+                    return None;
+                } else {
+                    continue;
+                }
+            };
+            match message {
                 Message::Output((bid, line)) => output(bid, line),
                 Message::Done(task) => {
                     self.tids.release(task.tid);
                     self.running -= 1;
-                    return task;
+                    return Some(task);
                 }
             }
         }
     }
 }
 
+impl Drop for Runner {
+    fn drop(&mut self) {
+        let (queue, ready) = &*self.queue;
+        {
+            let mut state = queue.lock().unwrap();
+            state.closed = true;
+            state.tasks.clear();
+        }
+        ready.notify_all();
+        for worker in self.workers.drain(..) {
+            let _ = worker.join();
+        }
+    }
+}
+
