+#[cfg(not(target_os = "macos"))]
+fn fuse_errno(host_errno: i32) -> i32 {
+    host_errno
+}
+
+/// FUSE is a Linux protocol, so its error field contains Linux errno values
+/// even when the server itself runs on another Unix.  Darwin diverges at
+/// EDEADLK and most values after ERANGE; forwarding its numeric errno would,
+/// for example, turn ENODATA (96) into Linux EPFNOSUPPORT and make execve(2)
+/// reject an otherwise valid binary after probing its security xattrs.
+#[cfg(target_os = "macos")]
+fn fuse_errno(host_errno: i32) -> i32 {
+    match host_errno {
+        1..=10 | 12..=34 => host_errno,
+        11 => 35,          // EDEADLK
+        35 => 11,          // EAGAIN
+        36 => 115,         // EINPROGRESS
+        37 => 114,         // EALREADY
+        38 => 88,          // ENOTSOCK
+        39 => 89,          // EDESTADDRREQ
+        40 => 90,          // EMSGSIZE
+        41 => 91,          // EPROTOTYPE
+        42 => 92,          // ENOPROTOOPT
+        43 => 93,          // EPROTONOSUPPORT
+        44 => 94,          // ESOCKTNOSUPPORT
+        45 | 102 => 95,    // ENOTSUP / EOPNOTSUPP
+        46 => 96,          // EPFNOSUPPORT
+        47 => 97,          // EAFNOSUPPORT
+        48 => 98,          // EADDRINUSE
+        49 => 99,          // EADDRNOTAVAIL
+        50 => 100,         // ENETDOWN
+        51 => 101,         // ENETUNREACH
+        52 => 102,         // ENETRESET
+        53 => 103,         // ECONNABORTED
+        54 => 104,         // ECONNRESET
+        55 => 105,         // ENOBUFS
+        56 => 106,         // EISCONN
+        57 => 107,         // ENOTCONN
+        58 => 108,         // ESHUTDOWN
+        59 => 109,         // ETOOMANYREFS
+        60 => 110,         // ETIMEDOUT
+        61 => 111,         // ECONNREFUSED
+        62 => 40,          // ELOOP
+        63 => 36,          // ENAMETOOLONG
+        64 => 112,         // EHOSTDOWN
+        65 => 113,         // EHOSTUNREACH
+        66 => 39,          // ENOTEMPTY
+        67 => 11,          // EPROCLIM (closest Linux equivalent: EAGAIN)
+        68 => 87,          // EUSERS
+        69 => 122,         // EDQUOT
+        70 => 116,         // ESTALE
+        71 => 66,          // EREMOTE
+        72..=76 => 71,     // BSD RPC errors (closest Linux equivalent: EPROTO)
+        77 => 37,          // ENOLCK
+        78 => 38,          // ENOSYS
+        79 => 22,          // EFTYPE (closest Linux equivalent: EINVAL)
+        80 | 81 => 13,     // EAUTH / ENEEDAUTH
+        82 | 83 => 5,      // EPWROFF / EDEVERR
+        84 => 75,          // EOVERFLOW
+        85 | 86 | 88 => 8, // EBADEXEC / EBADARCH / EBADMACHO
+        87 => 80,          // ESHLIBVERS (closest Linux equivalent: ELIBBAD)
+        89 => 125,         // ECANCELED
+        90 => 43,          // EIDRM
+        91 => 42,          // ENOMSG
+        92 => 84,          // EILSEQ
+        93 | 96 => 61,     // ENOATTR / ENODATA
+        94 => 74,          // EBADMSG
+        95 => 72,          // EMULTIHOP
+        97 => 67,          // ENOLINK
+        98 => 63,          // ENOSR
+        99 => 60,          // ENOSTR
+        100 => 71,         // EPROTO
+        101 => 62,         // ETIME
+        103 => 1,          // ENOPOLICY (closest Linux equivalent: EPERM)
+        104 => 131,        // ENOTRECOVERABLE
+        105 => 130,        // EOWNERDEAD
+        106 => 28,         // EQFULL (closest Linux equivalent: ENOSPC)
+        _ => 5,            // Unknown Darwin errors must not masquerade as another Linux errno.
+    }
+}
