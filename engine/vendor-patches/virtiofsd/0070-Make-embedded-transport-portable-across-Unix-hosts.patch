@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: BSD-3-Clause
+
+//! Transport-core OS helpers for non-Linux Unix hosts.
+//!
+//! The standalone passthrough daemon remains Linux-only. Sarun's own
+//! filesystem only needs positional vectored I/O and the protocol flag types.
+
+use bitflags::bitflags;
+use std::io;
+use std::os::fd::{AsRawFd, BorrowedFd};
+
+bitflags! {
+    /// Linux-compatible per-write flags carried by the FUSE protocol.
+    pub struct WritevFlags: i32 {
+        const RWF_HIPRI = 0x0000_0001;
+        const RWF_DSYNC = 0x0000_0002;
+        const RWF_SYNC = 0x0000_0004;
+        const RWF_APPEND = 0x0000_0010;
+        const RWF_NOAPPEND = 0x0000_0020;
+        const RWF_ATOMIC = 0x0000_0040;
+        const RWF_DONTCACHE = 0x0000_0080;
+    }
+}
+
+bitflags! {
+    /// Linux-compatible per-read flags carried by the FUSE protocol.
+    pub struct ReadvFlags: i32 {
+        const RWF_HIPRI = 0x0000_0001;
+        const RWF_NOWAIT = 0x0000_0008;
+        const RWF_DONTCACHE = 0x0000_0080;
+    }
+}
+
+/// Darwin counterpart of Linux `pwritev2` for the flag-free transport path.
+///
+/// macOS has `pwritev` but no per-call RWF flags. Refuse non-empty flags so a
+/// guest cannot mistake silently weakened semantics for success.
+pub unsafe fn writev_at(
+    fd: BorrowedFd<'_>,
+    iovecs: &[libc::iovec],
+    offset: i64,
+    flags: Option<WritevFlags>,
+) -> io::Result<usize> {
+    if flags.is_some_and(|value| !value.is_empty()) {
+        return Err(io::Error::from_raw_os_error(libc::EOPNOTSUPP));
+    }
+    // SAFETY: the caller guarantees every iovec points to readable memory.
+    let result = unsafe {
+        libc::pwritev(
+            fd.as_raw_fd(),
+            iovecs.as_ptr(),
+            iovecs.len() as libc::c_int,
+            offset as libc::off_t,
+        )
+    };
+    if result < 0 {
+        Err(io::Error::last_os_error())
+    } else {
+        Ok(result as usize)
+    }
+}
+
+/// Darwin counterpart of Linux `preadv2` for the flag-free transport path.
+pub unsafe fn readv_at(
+    fd: BorrowedFd<'_>,
+    iovecs: &[libc::iovec],
+    offset: i64,
+    flags: Option<ReadvFlags>,
+) -> io::Result<usize> {
+    if flags.is_some_and(|value| !value.is_empty()) {
+        return Err(io::Error::from_raw_os_error(libc::EOPNOTSUPP));
+    }
+    // SAFETY: the caller guarantees every iovec points to writable memory.
+    let result = unsafe {
+        libc::preadv(
+            fd.as_raw_fd(),
+            iovecs.as_ptr(),
+            iovecs.len() as libc::c_int,
+            offset as libc::off_t,
+        )
+    };
+    if result < 0 {
+        Err(io::Error::last_os_error())
+    } else {
+        Ok(result as usize)
+    }
+}
