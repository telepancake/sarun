 fn reply_error(e: io::Error, unique: u64, mut w: MessageWriter) -> Result<usize> {
+    let errno = fuse_errno(e.raw_os_error().unwrap_or(libc::EIO));
     let header = OutHeader {
         len: size_of::<OutHeader>() as u32,
-        error: -e.raw_os_error().unwrap_or(libc::EIO),
+        error: -errno,
