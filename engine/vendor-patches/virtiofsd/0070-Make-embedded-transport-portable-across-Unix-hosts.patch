+    #[cfg(target_os = "macos")]
+    #[test]
+    fn darwin_errnos_are_encoded_as_linux_fuse_errnos() {
+        assert_eq!(fuse_errno(libc::ENOENT), 2);
+        assert_eq!(fuse_errno(libc::EAGAIN), 11);
+        assert_eq!(fuse_errno(libc::ENOTEMPTY), 39);
+        assert_eq!(fuse_errno(libc::ENOSYS), 38);
+        assert_eq!(fuse_errno(libc::EOVERFLOW), 75);
+        assert_eq!(fuse_errno(libc::ENOATTR), 61);
+        assert_eq!(fuse_errno(libc::ENODATA), 61);
